# copy this file to .env and fill it in. .env is never committed.
# 1 = Ask Masar answers from templates, no model and no network (the default, used by all tests and demos)
# 0 = real mode: one call per question to the model below
FAKE_MODEL=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# the backend port (vite reads the same variable)
MASAR_PORT=8001
